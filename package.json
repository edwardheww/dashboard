{
  "name": "stock-screener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backtest": "tsx scripts/backtest.ts",
    "backtest:newfactors": "tsx scripts/backtest-newfactors.ts",
    "backtest:price-factors": "tsx scripts/backtest-price-factors.ts",
    "backtest:intraday": "tsx scripts/backtest-intraday.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply dashboard-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dashboard-db --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "groq-sdk": "^1.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "wrangler": "^4.120.1"
  }
}
